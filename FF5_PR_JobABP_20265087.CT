<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"全隊現有職業 ABP 補滿（轉職後戰鬥升至 MASTER；尚未完成戰鬥驗證）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

assert(getOpenedProcessID()~=0,'Attach to FINAL FANTASY V first')
local base=getAddressSafe('GameAssembly.dll');assert(base,'GameAssembly.dll missing')
local pe=base+readInteger(base+60)
assert(readInteger(pe+8)==1738631357 and readInteger(pe+80)==40267776,'Requires FF5 PR Steam build 20265087')
assert(LaunchMonoDataCollector(),'Mono data collector unavailable')
local function cls(name)
 local c=mono_findClass('Last.Data.User',name);assert(c and c~=0,'Class missing: '..name);return c
end
local function fld(c,name,expectedType)
 for _,v in ipairs(mono_class_enumFields(c,true) or {}) do
  if v.name==name then assert(not expectedType or v.typename==expectedType,'Unexpected field type: '..name);return v end
 end
 error('Field missing: '..name)
end
local function ptr(a)
 local p=readPointer(a);assert(p and p&gt;0x10000,'Invalid pointer');return p
end
local function list(o,max)
 local c=mono_object_getClass(o);assert(c and c~=0,'Invalid list')
 local count=readInteger(o+fld(c,'_size','System.Int32').offset)
 assert(count and count&gt;=0 and count&lt;=max,'Unexpected list size')
 local a=ptr(o+fld(c,'_items').offset);local length=readInteger(a+0x18)
 assert(length and length&gt;=count and length&lt;=512,'Invalid list capacity')
 local r={};for i=0,count-1 do r[#r+1]=ptr(a+0x20+i*8) end;return r
end
local um=mono_findClass('Last.Management','UserDataManager');assert(um and um~=0,'UserDataManager missing')
local instance=fld(um,'instance');local u=mono_class_getStaticFieldValue(um,instance.field)
assert(u and u&gt;0x10000,'Load your save first')
local chars=list(ptr(u+fld(um,'&lt;OwnedCharacterList&gt;k__BackingField').offset),16)
local chClass=cls('OwnedCharacterData');local chSave=cls('OwnedCharacterSaveData')
local jobClass=cls('OwnedJobData');local jobSave=cls('OwnedJobSaveData')
local chSaveOffset=fld(chClass,'saveData').offset
local chJobsOffset=fld(chClass,'&lt;OwnedJobDataList&gt;k__BackingField').offset
local idOffset=fld(chSave,'id','System.Int32').offset
local enabledOffset=fld(chSave,'isEnableCorps','System.Boolean').offset
local jobSaveOffset=fld(jobClass,'saveData').offset
local jobIdOffset=fld(jobSave,'id','System.Int32').offset
local abpOffset=fld(jobSave,'currentProficiency','System.Int32').offset
local levelOffset=fld(jobSave,'level','System.Int32').offset
local targets={[2]=635,[3]=700,[4]=1159,[5]=580,[6]=730,[7]=690,[8]=690,[9]=600,[10]=175,[11]=560,[12]=175,[13]=750,[14]=500,[15]=820,[16]=530,[17]=630,[18]=400,[19]=350,[20]=680,[21]=460,[22]=999}

local plans={};local seenChars={};local active=0
for _,ch in ipairs(chars) do
 assert(mono_object_getClass(ch)==chClass,'Unexpected character object')
 local save=ptr(ch+chSaveOffset);assert(mono_object_getClass(save)==chSave,'Unexpected character save object')
 local id=readInteger(save+idOffset);assert(id and id&gt;=1 and id&lt;=5 and not seenChars[id],'Unexpected or duplicate character ID');seenChars[id]=true
 if readBytes(save+enabledOffset,1)==1 then
  active=active+1
  local jobs=list(ptr(ch+chJobsOffset),32);local seenJobs={}
  for _,job in ipairs(jobs) do
   assert(mono_object_getClass(job)==jobClass,'Unexpected job object')
   local js=ptr(job+jobSaveOffset);assert(mono_object_getClass(js)==jobSave,'Unexpected job save object')
   local jid=readInteger(js+jobIdOffset);assert(jid and jid&gt;=1 and jid&lt;=22 and not seenJobs[jid],'Unexpected job ID');seenJobs[jid]=true
   local target=targets[jid]
   if target then
    local address=js+abpOffset;local before=readInteger(address);local level=readInteger(js+levelOffset)
    assert(before and before&gt;=0 and before&lt;=9999999 and level and level&gt;=1 and level&lt;=8,'Invalid job values')
    plans[#plans+1]={address=address,before=before,target=math.max(before,target),character=id,job=jid,levelAddress=js+levelOffset,level=level}
   end
  end
 end
end
assert(active==4 and #plans&gt;0,'Load a save with four active party members first')
for _,p in ipairs(plans) do
 assert(readInteger(p.address)==p.before and readInteger(p.levelAddress)==p.level,'Game state changed; try again on the map')
end
if FF5_ABP_READ_ONLY_TEST then
 return plans
end
local changed={}
local ok,err=pcall(function()
 for _,p in ipairs(plans) do
  if p.target~=p.before then
   assert(writeInteger(p.address,p.target),'ABP write failed');changed[#changed+1]=p
  end
  assert(readInteger(p.address)==p.target and readInteger(p.levelAddress)==p.level,'ABP verification failed')
 end
end)
if not ok then
 for _,p in ipairs(changed) do writeInteger(p.address,p.before) end
 error(err)
end
print('ABP VERIFIED: '..active..' characters, '..#plans..' unlocked jobs')
showMessage('已補滿全隊現有職業的 ABP。每個職業轉職後贏一場戰鬥，讓遊戲自行升級及學習能力。此 CT 不直接設定職業等級，也不新增未解鎖職業。取消勾選不會還原 ABP。')

{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
</CheatTable>