<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"補齊傳說 12 武器：背包各至少 1 件（不修改劇情；地圖上執行一次）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local function find(ns,cls,name,signature)
 local c=mono_findClass(ns,cls)
 assert(c and c~=0,'Class missing: '..cls)
 for _,m in ipairs(mono_class_enumMethods(c)) do
  if m.name==name and (not signature or mono_method_getSignature(m.method)==signature) then return m.method end
 end
 error('Method missing: '..cls..'.'..name)
end
local function call(m,obj,args)
 local r,e=mono_invoke_method(0,m,obj or 0,args or {})
 assert(e==nil,tostring(e))
 return r
end
local function instance(ns,cls)
 local c=mono_findClass(ns,cls)
 local obj=mono_object_new(c)
 assert(obj and obj~=0,'Cannot create '..cls)
 call(find(ns,cls,'.ctor',''),obj)
 return obj
end
local function setup()
 assert(getOpenedProcessID()~=0,'Attach to FINAL FANTASY V.exe first')
 local base=getAddressSafe('GameAssembly.dll')
 assert(base,'FF5 GameAssembly.dll missing')
 local pe=base+readInteger(base+60)
 assert(readInteger(pe+8)==1738631357 and readInteger(pe+80)==40267776,'This CT requires FF5 PR Steam build 20265087')
 assert(LaunchMonoDataCollector(),'Mono collector unavailable')
 local manager=call(find('Last.Management','UserDataManager','Instance',''))
 assert(manager and manager~=0,'Load your save and stop on the map first')
 return manager
end

local methodCache={}
local function method(o,n,sig)
 local c=mono_object_getClass(o)
 local key=tostring(c)..':'..n..':'..tostring(sig)
 if methodCache[key] then return methodCache[key] end
 while c and c~=0 do
  for _,v in ipairs(mono_class_enumMethods(c)) do
   if v.name==n and (not sig or mono_method_getSignature(v.method)==sig) then methodCache[key]=v.method;return v.method end
  end
  c=mono_class_getParent(c)
 end
 error('Missing method '..n)
end
local function g(o,n,args,sig) assert(o and o~=0,'Missing object for '..n);return call(method(o,n,sig),o,args) end
local u=setup()
assert(g(u,'GetMemberData',{0})~=0,'Load a save and stop on the map first')
local items={
{69,"暗殺短劍",1},
{75,"佐助之刀",1},
{92,"石中劍",1},
{104,"神聖槍",1},
{114,"符文斧",1},
{124,"正宗",1},
{133,"巫師棒",1},
{140,"賢者之杖",1},
{155,"與一之弓",1},
{161,"阿波羅豎琴",1},
{166,"烈焰鞭",1},
{169,"大地之鈴",1},
}

local search=find('Last.Management','UserDataManager','SearchOwnedItem','System.Int32')
local count=find('Last.Data.User','OwnedItemData','get_Count','')
local client=instance('Last.Management','OwnedItemClient')
local add=find('Last.Management','OwnedItemClient','AddOwnedItem','System.Int32,System.Int32')
local plans={}
for _,v in ipairs(items) do
 local o=call(search,u,{v[1]})
 local n=(o and o~=0) and call(count,o) or 0
 assert(n&gt;=0 and n&lt;=99,'Invalid item quantity: '..v[2])
 plans[#plans+1]={id=v[1],name=v[2],target=math.max(n,v[3]),delta=math.max(0,v[3]-n)}
end
for _,v in ipairs(plans) do
 if v.delta&gt;0 then call(add,client,{v.id,v.delta}) end
 local o=call(search,u,{v.id})
 assert(o and o~=0 and call(count,o)==v.target,'Item verification failed: '..v.name)
 print(v.name..': '..v.target..' verified')
end
print('SEALED 12 WEAPONS VERIFIED: '..#plans..' types')

showMessage("傳說 12 武器已逐項核對：背包各至少 1 件，原有較多的數量保留。請重新開啟道具選單確認，另存新欄位。此項不寫入石板或封印劇情紀錄；取消勾選不會撤回武器。")
{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
</CheatTable>