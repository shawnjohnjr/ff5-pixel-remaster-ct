local function fld(c,name,expectedType)
 for _,v in ipairs(mono_class_enumFields(c,true) or {}) do
  if v.name==name then assert(not expectedType or v.typename==expectedType,'Unexpected field type: '..name);return v end
 end
 error('Field missing: '..name)
